# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://nerm:nerm@localhost:5432/nerm?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-value"
AUTH_URL="http://localhost:3000"
# Set to "true" only behind a trusted reverse proxy.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# OIDC provider (generic — works with Entra ID, Okta, Keycloak, ISC)
# ---------------------------------------------------------------------------
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# Okta:     https://<org>.okta.com/oauth2/default
# Keycloak: http://localhost:8080/realms/nerm
OIDC_ISSUER="http://localhost:8080/realms/nerm"
OIDC_CLIENT_ID="nerm-platform"
OIDC_CLIENT_SECRET="nerm-platform-secret"
OIDC_PROVIDER_NAME="Corporate SSO"
# Optional: extra scopes beyond "openid profile email"
OIDC_SCOPES=""

# ---------------------------------------------------------------------------
# Object storage (documents: NDA, ID proof)
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-1"
S3_BUCKET="nerm-attachments"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Days before endDate at which a person moves to EXPIRING.
EXPIRY_WARNING_DAYS="30"
# Shared secret for invoking scheduled jobs (/api/v1/jobs/*).
JOB_TRIGGER_SECRET="replace-me"
